{
  "name": "miniblog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight personal blog on Cloudflare Workers — shares auth & assets with Minidriver",
  "scripts": {
    "dev": "concurrently -c yellow,cyan -n api,admin \"wrangler dev\" \"vite build --watch --outDir public/admin\"",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && node scripts/resolve-config.mjs && wrangler deploy",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.admin.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply miniblog --local",
    "db:migrate:remote": "wrangler d1 migrations apply miniblog --remote",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@tanstack/react-query": "^5.103.1",
    "hono": "^4.13.8",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
