{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miniblog",
  "main": "server/index.tsx",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  // 命中静态资产的请求也先进 Worker：/admin/* 需要附加安全头（CSP 等），其余 SSR / API / 直链
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/admin/*", "/api/*", "/post/*", "/archive", "/tags", "/tag/*", "/page/*", "/rss.xml", "/sitemap.xml", "/assets/*", "/themes/*"]
  },
  // ── 资源指向即联动：与 minidriver 配到同一 D1/R2 即共享账号与素材，否则各自独立 ──
  // GitHub Secrets：D1_DATABASE_ID / R2_BUCKET_NAME 在部署时注入（scripts/resolve-config.mjs），
  // 两个仓库配同值即联动；本地开发用下方默认名即可。
  // 联动时建议 database_name 也改为 "minidriver"（线上以 database_id 为准；本地模拟共享需同名）。
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "miniblog" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miniblog",
      // 占位符：真实 ID 由 CI 部署时经 scripts/resolve-config.mjs 注入（GitHub Secret D1_DATABASE_ID）。
      // 本地开发不校验真实 ID；该文件不应包含任何个人基础设施信息
      "database_id": "LOCAL_DEV_ONLY",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // APP_PUBLIC_URL（规范对外地址：Passkey RP / CSRF Origin / 素材直链）不放这里 ——
    // 它以 Cloudflare Secret 形式在 dashboard 设置一次，部署永不覆盖，代码零痕迹。
    // 本地开发在 .dev.vars 里配置；留空时运行时自动回退到请求来源（单域名零配置）。
    // 可选 SSO 联动（与 minidriver 同时设置，dashboard 里配）：
    //   AUTH_RP_ID / AUTH_COOKIE_DOMAIN = <根域> → 两应用共享登录，Passkey 跨应用
    "ALLOWED_ORIGINS": ""
  },
  // Secrets（wrangler secret put / dashboard）：
  //   SESSION_ENC_KEY — 32 字节 base64；与 minidriver 联动时同值（共享 TOTP 密文语义）
  //   SETUP_TOKEN     — 首次 /admin/setup 口令；与 minidriver 联动时同值
  "observability": { "enabled": true }
}
