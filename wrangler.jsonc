{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miniblog",
  "main": "server/index.tsx",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  // 命中静态资产的请求也先进 Worker：/admin/* 需要附加安全头（CSP 等），其余 SSR / API / 直链
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/admin/*", "/api/*", "/post/*", "/archive", "/tags", "/tag/*", "/page/*", "/rss.xml", "/sitemap.xml", "/assets/*", "/themes/*"]
  },
  // ── 资源指向即联动：与 minidriver 配到同一 D1/R2 即共享账号与素材，否则各自独立 ──
  // GitHub Secrets：D1_DATABASE_ID / R2_BUCKET_NAME 在部署时注入（scripts/resolve-config.mjs），
  // 两个仓库配同值即联动；本地开发用下方默认名即可。
  // 联动时建议 database_name 也改为 "minidriver"（线上以 database_id 为准；本地模拟共享需同名）。
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "miniblog" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miniblog",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 博客对外域名（Passkey RP、CSRF Origin、素材直链都取自它）——必须与实际访问域一致
    "APP_PUBLIC_URL": "https://blog.<your-domain>",
    // 可选 SSO 联动：与 minidriver 同时设置 <根域> → 两应用共享登录（__Secure- Cookie + Domain），
    // Passkey 可跨应用（依赖公共后缀清单）。留空 = 各自独立登录（账号仍随 D1 收敛共享）
    "AUTH_RP_ID": "",
    "AUTH_COOKIE_DOMAIN": "",
    "ALLOWED_ORIGINS": ""
  },
  // Secrets（wrangler secret put / dashboard）：
  //   SESSION_ENC_KEY — 32 字节 base64；与 minidriver 联动时同值（共享 TOTP 密文语义）
  //   SETUP_TOKEN     — 首次 /admin/setup 口令；与 minidriver 联动时同值
  "observability": { "enabled": true }
}
